{
  "name": "daily-streak-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "A MERN app for tracking coding activity and streaks",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "concurrently --kill-others-on-fail \"npm test -w server\" \"npm test -w client\"",
    "test:email": "node server/scripts/test-email.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "prettier": "^3.3.3"
  }
}
