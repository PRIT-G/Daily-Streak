# Copy this file to server/.env and replace production secrets with private values.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/daily-streak-tracker

# Local development fallback only. Production requires a private secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Optional shared OAuth setup. OAuth token encryption keys must be 64 hex characters.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_ADMIN_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Required in production for account verification and recovery; optional in local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Daily Streak <noreply@example.com>"

LOG_LEVEL=info
